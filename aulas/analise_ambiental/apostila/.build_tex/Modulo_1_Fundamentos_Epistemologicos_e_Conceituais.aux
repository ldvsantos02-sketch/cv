\newlabel{cap:conceitos-operacionais}{{4}{79}{Conceitos Operacionais da Análise Ambiental}{chapter.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.1}Ambiente e Meio Ambiente: Enquadramento Legal e Científico}{80}{section.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4.2}Aspecto Ambiental vs. Impacto Ambiental e Classificação de Impactos}{80}{section.4.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4.3}Poluição vs. Degradação Ambiental}{81}{section.4.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4.4}Perigo, Vulnerabilidade, Fragilidade Ambiental e Risco Ambiental}{82}{section.4.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Conceitos operacionais centrais da Análise Ambiental. \textbf  {Subfigura (a):} cadeia causal Atividade Humana $\rightarrow $ Aspecto Ambiental $\rightarrow $ Impacto Ambiental segundo Sánchez (2013), destacando a diferença entre mecanismo de interação (aspecto) e alteração na qualidade ambiental (impacto). \textbf  {Subfigura (b):} Matriz Conceitual de Risco Ambiental ($R = P \times V$) em escala ordinal $4 \times 4$, combinando níveis de Perigo/Ameaça ($P$) e Vulnerabilidade ($V$) em quatro classes operacionais (Baixo, Médio, Alto e Crítico).}}{83}{figure.4.1}\protected@file@percent }
\newlabel{fig:aspecto-risco}{{4.1}{83}{Conceitos operacionais centrais da Análise Ambiental. \textbf {Subfigura (a):} cadeia causal Atividade Humana $\rightarrow $ Aspecto Ambiental $\rightarrow $ Impacto Ambiental segundo Sánchez (2013), destacando a diferença entre mecanismo de interação (aspecto) e alteração na qualidade ambiental (impacto). \textbf {Subfigura (b):} Matriz Conceitual de Risco Ambiental ($R = P \times V$) em escala ordinal $4 \times 4$, combinando níveis de Perigo/Ameaça ($P$) e Vulnerabilidade ($V$) em quatro classes operacionais (Baixo, Médio, Alto e Crítico)}{figure.4.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces \textbf  {Distinção operacional entre fragilidade física, perigo, vulnerabilidade e risco ($R = P \times V$).} \textit  {O que observar:} ambas as encostas possuem a mesma declividade de 38\% e solo raso (mesma fragilidade física), porém na Vertente 1 a ausência de exposição humana zera o risco ($V = 0 \Rightarrow R = 0$). Na Vertente 2, o desmatamento e a ocupação na base elevam o perigo e a vulnerabilidade, convertendo a fragilidade física em risco crítico ($R = 16$). Fonte: Elaboração didática CHF662.}}{83}{figure.4.2}\protected@file@percent }
\newlabel{fig:risco_vs_fragilidade}{{4.2}{83}{\textbf {Distinção operacional entre fragilidade física, perigo, vulnerabilidade e risco ($R = P \times V$).} \textit {O que observar:} ambas as encostas possuem a mesma declividade de 38\% e solo raso (mesma fragilidade física), porém na Vertente 1 a ausência de exposição humana zera o risco ($V = 0 \Rightarrow R = 0$). Na Vertente 2, o desmatamento e a ocupação na base elevam o perigo e a vulnerabilidade, convertendo a fragilidade física em risco crítico ($R = 16$). Fonte: Elaboração didática CHF662}{figure.4.2}{}}

\newlabel{cap:abordagens-geografia}{{3}{55}{Abordagens Ambientais na Geografia Moderna}{chapter.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3.1}Evolução das Abordagens Ambientais no Pensamento Geográfico Moderno}{56}{section.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces \textbf  {Da unidade clássica da paisagem à religação socioambiental contemporânea na Geografia.} \textit  {O que observar:} a subfigura (a) ilustra a leitura integrada dos componentes físico-bióticos na Geografia Clássica de Humboldt (1805). A subfigura (b) indica por que a análise ambiental atual exige religar geomorfologia de encostas e produção desigual do espaço urbano (Mendonça, 2001). Fonte: Acervo histórico em domínio público (A) e acervo didático CHF662 (B).}}{57}{figure.3.1}\protected@file@percent }
\newlabel{fig:humboldt_socioambiental_cap3}{{3.1}{57}{\textbf {Da unidade clássica da paisagem à religação socioambiental contemporânea na Geografia.} \textit {O que observar:} a subfigura (a) ilustra a leitura integrada dos componentes físico-bióticos na Geografia Clássica de Humboldt (1805). A subfigura (b) indica por que a análise ambiental atual exige religar geomorfologia de encostas e produção desigual do espaço urbano (Mendonça, 2001). Fonte: Acervo histórico em domínio público (A) e acervo didático CHF662 (B)}{figure.3.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3.2}A Superação da Dicotomia e a Geografia Socioambiental (Mendonça, 2001)}{58}{section.3.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3.3}Distinção Rigorosa e Articulação: Espaço, Paisagem, Território e Ambiente}{59}{section.3.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3.4}O Esboço Metodológico da Paisagem e o Sistema Tripolar GTP (Bertrand, 2004)}{60}{section.3.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Fundamentos integradores da Análise Ambiental na Geografia moderna. \textbf  {Subfigura (a):} articulação entre Meio Físico, Meio Biótico e Sociedade \& Território, cujo núcleo de interseção define a Análise Ambiental Integrada sob a perspectiva da Geografia Socioambiental (Mendonça, 2001). \textbf  {Subfigura (b):} Sistema Tripolar GTP de Georges Bertrand (2004), evidenciando as relações bidirecionais entre Geossistema (G), Território (T) e Paisagem (P) como três entradas complementares sobre a mesma realidade socioambiental.}}{61}{figure.3.2}\protected@file@percent }
\newlabel{fig:triade-gtp}{{3.2}{61}{Fundamentos integradores da Análise Ambiental na Geografia moderna. \textbf {Subfigura (a):} articulação entre Meio Físico, Meio Biótico e Sociedade \& Território, cujo núcleo de interseção define a Análise Ambiental Integrada sob a perspectiva da Geografia Socioambiental (Mendonça, 2001). \textbf {Subfigura (b):} Sistema Tripolar GTP de Georges Bertrand (2004), evidenciando as relações bidirecionais entre Geossistema (G), Território (T) e Paisagem (P) como três entradas complementares sobre a mesma realidade socioambiental}{figure.3.2}{}}

\@writefile{toc}{\contentsline {section}{\numberline {1.2}Degradação dos Solos, Escassez Hídrica e Mudanças no Uso da Terra}{6}{section.1.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.2.1}Mudanças no Uso da Terra como Vetor Desencadeador}{6}{subsection.1.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces \textbf  {Vetores de mudança no uso da terra na Bahia.} \textit  {O que observar:} na subfigura (a), a perda de cobertura vegetal em áreas de pastoreio intensivo expõe o solo ao escoamento concentrado e desencadeia incisões erosivas escalonadas. Na subfigura (b), os círculos escuros evidenciam a conversão em larga escala das chapadas do Oeste Baiano por agricultura irrigada mecanizada, elevando a pressão sobre a recarga hídrica. Fonte: Acervo didático CHF662 (A) e INPE/Wikimedia Commons, CC BY-SA (B).}}{7}{figure.1.1}\protected@file@percent }
\newlabel{fig:vetores_bahia}{{1.1}{7}{\textbf {Vetores de mudança no uso da terra na Bahia.} \textit {O que observar:} na subfigura (a), a perda de cobertura vegetal em áreas de pastoreio intensivo expõe o solo ao escoamento concentrado e desencadeia incisões erosivas escalonadas. Na subfigura (b), os círculos escuros evidenciam a conversão em larga escala das chapadas do Oeste Baiano por agricultura irrigada mecanizada, elevando a pressão sobre a recarga hídrica. Fonte: Acervo didático CHF662 (A) e INPE/Wikimedia Commons, CC BY-SA (B)}{figure.1.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.2.2}Degradação dos Solos e Processos Erosivos}{7}{subsection.1.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces \textbf  {Conectividade hidrossedimentológica entre erosão em encostas e assoreamento a jusante.} \textit  {O que observar:} em (a) e (b), a exposição do solo acelera a passagem da erosão laminar e em sulcos para incisões lineares profundas (voçorocas). Em (c) e (d), o sedimento mobilizado das vertentes deposita-se nas calhas fluviais e reservatórios, diminuindo o volume útil de água disponível. Fonte: Acervo didático CHF662.}}{8}{figure.1.2}\protected@file@percent }
\newlabel{fig:erosao_assoreamento_cap1}{{1.2}{8}{\textbf {Conectividade hidrossedimentológica entre erosão em encostas e assoreamento a jusante.} \textit {O que observar:} em (a) e (b), a exposição do solo acelera a passagem da erosão laminar e em sulcos para incisões lineares profundas (voçorocas). Em (c) e (d), o sedimento mobilizado das vertentes deposita-se nas calhas fluviais e reservatórios, diminuindo o volume útil de água disponível. Fonte: Acervo didático CHF662}{figure.1.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.2.3}Escassez Hídrica: Condição Climática versus Produção Socioambiental}{8}{subsection.1.2.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {1.3}O Debate Crítico: Desenvolvimento Sustentável versus Sustentabilidade}{9}{section.1.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1.3}{\ignorespaces \textbf  {Do discurso institucional do desenvolvimento sustentável às práticas territoriais de sustentabilidade.} \textit  {O que observar:} a subfigura (a) remete ao marco político da Rio-92 que difundiu o conceito de desenvolvimento sustentável, enquanto a subfigura (b) evidencia a contradição da expansão produtiva contínua sobre ecossistemas nativos como o Cerrado. Em contraste, a subfigura (c) materializa a sustentabilidade socioambiental ancorada na autonomia hídrica e na convivência com os limites biofísicos do Semiárido. Fonte: Acervo didático CHF662 e MDS.}}{10}{figure.1.3}\protected@file@percent }
\newlabel{fig:sustentabilidade_debate_cap1}{{1.3}{10}{\textbf {Do discurso institucional do desenvolvimento sustentável às práticas territoriais de sustentabilidade.} \textit {O que observar:} a subfigura (a) remete ao marco político da Rio-92 que difundiu o conceito de desenvolvimento sustentável, enquanto a subfigura (b) evidencia a contradição da expansão produtiva contínua sobre ecossistemas nativos como o Cerrado. Em contraste, a subfigura (c) materializa a sustentabilidade socioambiental ancorada na autonomia hídrica e na convivência com os limites biofísicos do Semiárido. Fonte: Acervo didático CHF662 e MDS}{figure.1.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {1.4}Planejamento Ambiental e o Papel Integrador da Geografia}{10}{section.1.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1.4}{\ignorespaces \textbf  {Contraste hidrogeomorfológico entre semiaridez climática e escassez socioambiental.} \textit  {O que observar:} sob a mesma precipitação anual de 580 mm, a Microbacia A conserva a cobertura arbustiva, favorece a infiltração e mantém o lençol freático elevado para abastecimento em cacimbas. Na Microbacia B, a compactação do solo redireciona a água para o escoamento superficial rápido, acelerando a erosão e o assoreamento do açude. Fonte: Elaboração didática CHF662.}}{14}{figure.1.4}\protected@file@percent }
\newlabel{fig:contraste_microbacias}{{1.4}{14}{\textbf {Contraste hidrogeomorfológico entre semiaridez climática e escassez socioambiental.} \textit {O que observar:} sob a mesma precipitação anual de 580 mm, a Microbacia A conserva a cobertura arbustiva, favorece a infiltração e mantém o lençol freático elevado para abastecimento em cacimbas. Na Microbacia B, a compactação do solo redireciona a água para o escoamento superficial rápido, acelerando a erosão e o assoreamento do açude. Fonte: Elaboração didática CHF662}{figure.1.4}{}}

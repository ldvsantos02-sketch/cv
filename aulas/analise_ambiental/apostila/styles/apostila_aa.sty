\newcommand{\aberturaModulo}[4]{%
  \cleardoublepage
  \phantomsection
  \addcontentsline{toc}{part}{#2}
  \thispagestyle{empty}
  \begin{tikzpicture}[remember picture, overlay]
    \fill[uefsNavyDark] (current page.north west) rectangle ([yshift=-9.4cm]current page.north east);
    \fill[uefsTeal] ([yshift=-9.4cm]current page.north west) rectangle ([yshift=-9.72cm]current page.north east);
    \fill[uefsGold] ([yshift=-9.72cm]current page.north west) rectangle ([yshift=-9.88cm]current page.north east);
    \fill[uefsTeal, opacity=0.22] ([xshift=14cm, yshift=-1.8cm]current page.north west) circle (4.6cm);
    \fill[uefsGold, opacity=0.14] ([xshift=18cm, yshift=-7.2cm]current page.north west) circle (3.2cm);
  \end{tikzpicture}
  \vspace*{1.0cm}
  {\color{uefsGold}\bfseries\Large\sffamily #1}\par
  \vspace{0.35cm}
  {\color{white}\bfseries\fontsize{22}{27}\selectfont\sffamily\raggedright #2}\par
  \vspace{0.6cm}
  \begin{tcolorbox}[colback=white!10!uefsNavyDark, colframe=uefsGold, arc=3pt, boxrule=0.8pt, width=0.92\textwidth, left=8pt, right=8pt, top=5pt, bottom=5pt]
    {\color{uefsGold}\bfseries\small VÍNCULO NO PLANO CHF662: } {\color{bgGold}\small #3}
  \end{tcolorbox}
  \vspace{2.6cm}
  \begin{tcolorbox}[colback=bgSoft, colframe=uefsNavy, arc=4pt, boxrule=1pt, title={\bfseries Visão Geral e Estrutura deste Módulo}, coltitle=white, colbacktitle=uefsNavy, left=12pt, right=12pt, top=10pt, bottom=10pt]
    #4
  \end{tcolorbox}
  \vfill
  \begin{center}
    {\small\color{uefsMuted}\itshape ``Compreender o ambiente exige integrar solo, água, relevo, biota e sociedade sob rigor metodológico.''}
  \end{center}
  \clearpage
}


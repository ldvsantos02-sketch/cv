\@writefile{toc}{\contentsline {section}{\numberline {2.1}Formação Histórica da Questão Ambiental na Modernidade}{31}{section.2.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.1.1}A Ruptura Cartesiana entre Sociedade e Natureza}{32}{subsection.2.1.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2.2}A Natureza como Construção Social e Histórica (Porto-Gonçalves, 2006)}{32}{section.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2.1}{\ignorespaces \textbf  {Construção social da natureza: territorialidade tradicional versus apropriação mercantil.} \textit  {O que observar:} na subfigura (a), comunidades indígenas e tradicionais articulam reprodução social, memória e conservação ambiental em um mesmo território vivido. Na subfigura (b), a racionalidade instrumental separa sociedade e natureza, convertendo o relevo e o subsolo em frentes extrativas de alto impacto. Fonte: Acervo didático CHF662.}}{33}{figure.2.1}\protected@file@percent }
\newlabel{fig:construcao_social_natureza_cap2}{{2.1}{33}{\textbf {Construção social da natureza: territorialidade tradicional versus apropriação mercantil.} \textit {O que observar:} na subfigura (a), comunidades indígenas e tradicionais articulam reprodução social, memória e conservação ambiental em um mesmo território vivido. Na subfigura (b), a racionalidade instrumental separa sociedade e natureza, convertendo o relevo e o subsolo em frentes extrativas de alto impacto. Fonte: Acervo didático CHF662}{figure.2.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.3}Apropriação dos Recursos Naturais e Racionalidade Instrumental}{34}{section.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2.2}{\ignorespaces \textbf  {Descompasso de temporalidades entre o tempo do capital e o tempo da natureza.} \textit  {O que observar:} a barra superior ilustra o ciclo linear e curto de retorno econômico (1 a 10 anos), pressionando os sistemas produtivos para extração acelerada. Na faixa inferior, os ciclos ecológicos e pedogenéticos exigem décadas a milênios para recompor a vegetação da Caatinga, recarregar aquíferos e formar solo fértil. Fonte: Elaboração didática CHF662 com base em Leff (2001) e Porto-Gonçalves (2006).}}{34}{figure.2.2}\protected@file@percent }
\newlabel{fig:temporalidades}{{2.2}{34}{\textbf {Descompasso de temporalidades entre o tempo do capital e o tempo da natureza.} \textit {O que observar:} a barra superior ilustra o ciclo linear e curto de retorno econômico (1 a 10 anos), pressionando os sistemas produtivos para extração acelerada. Na faixa inferior, os ciclos ecológicos e pedogenéticos exigem décadas a milênios para recompor a vegetação da Caatinga, recarregar aquíferos e formar solo fértil. Fonte: Elaboração didática CHF662 com base em Leff (2001) e Porto-Gonçalves (2006)}{figure.2.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.4}Conflitos Socioambientais e Produção do Espaço na Bahia e no Nordeste}{35}{section.2.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2.3}{\ignorespaces \textbf  {Conflitos socioambientais e produção do espaço na Bahia e no Nordeste.} \textit  {O que observar:} as subfiguras (a), (b) e (c) exemplificam disputas territoriais envolvendo expansão energética com supressão vegetal, barramento hidrelétrico no São Francisco e fronteira agrícola irrigada no MATOPIBA. Na subfigura (d), destaca-se a organização comunitária em território quilombola no Semiárido baiano, articulando permanência territorial e convivência com o ambiente. Fonte: Acervo didático CHF662 e Projeto Catuxe/UEFS (D).}}{36}{figure.2.3}\protected@file@percent }
\newlabel{fig:conflitos_bahia}{{2.3}{36}{\textbf {Conflitos socioambientais e produção do espaço na Bahia e no Nordeste.} \textit {O que observar:} as subfiguras (a), (b) e (c) exemplificam disputas territoriais envolvendo expansão energética com supressão vegetal, barramento hidrelétrico no São Francisco e fronteira agrícola irrigada no MATOPIBA. Na subfigura (d), destaca-se a organização comunitária em território quilombola no Semiárido baiano, articulando permanência territorial e convivência com o ambiente. Fonte: Acervo didático CHF662 e Projeto Catuxe/UEFS (D)}{figure.2.3}{}}

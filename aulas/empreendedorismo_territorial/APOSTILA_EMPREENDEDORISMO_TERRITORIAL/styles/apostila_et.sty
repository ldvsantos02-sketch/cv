% 6. BANNER DE ABERTURA DE UNIDADE
% ============================================================================
\newcommand{\aberturaModulo}[4]{%
  \cleardoublepage
  \phantomsection
  \addcontentsline{toc}{part}{#2}
  \thispagestyle{empty}
  \begin{tikzpicture}[remember picture, overlay]
    \fill[etIndigoDark] (current page.north west) rectangle ([yshift=-9.4cm]current page.north east);
    \fill[etTeal] ([yshift=-9.4cm]current page.north west) rectangle ([yshift=-9.72cm]current page.north east);
    \fill[etAmber] ([yshift=-9.72cm]current page.north west) rectangle ([yshift=-9.88cm]current page.north east);
    \fill[etTeal, opacity=0.22] ([xshift=14cm, yshift=-1.8cm]current page.north west) circle (4.6cm);
    \fill[etAmber, opacity=0.14] ([xshift=18cm, yshift=-7.2cm]current page.north west) circle (3.2cm);
  \end{tikzpicture}
  \vspace*{1.0cm}
  {\color{etAmber}\bfseries\Large\sffamily #1}\par
  \vspace{0.35cm}
  {\color{white}\bfseries\fontsize{22}{27}\selectfont\sffamily\raggedright #2}\par
  \vspace{0.6cm}
  \begin{tcolorbox}[colback=white!10!etIndigoDark, colframe=etAmber, arc=3pt, boxrule=0.8pt, width=0.92\textwidth, left=8pt, right=8pt, top=5pt, bottom=5pt]
    {\color{etAmber}\bfseries\small VÍNCULO NA DISCIPLINA: } {\color{bgAmber}\small #3}
  \end{tcolorbox}
  \vspace{2.6cm}
  \begin{tcolorbox}[colback=bgSoft, colframe=etIndigo, arc=4pt, boxrule=1pt, title={\bfseries Visão Geral e Estrutura desta Unidade}, coltitle=white, colbacktitle=etIndigo, left=12pt, right=12pt, top=10pt, bottom=10pt]
    #4
  \end{tcolorbox}
  \vfill
  \begin{center}
    {\small\color{etMuted}\itshape ``Tecnologia sem enraizamento territorial concentra renda; território sem inovação perde capacidade de retenção de valor.''}
  \end{center}
  \clearpage
}

